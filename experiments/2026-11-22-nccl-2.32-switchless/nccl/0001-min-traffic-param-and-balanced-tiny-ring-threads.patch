From 1e604d439ca4dba91539701071c01b3d06cb0be6 Mon Sep 17 00:00:00 2001
From: aotsukiqx <y.aotsuki@gmail.com>
Date: Sat, 21 Nov 2026 15:23:05 +0800
Subject: [PATCH] Re-express switchless patches 0003/0004 on 2.32.6-1: lazy
 MIN_TRAFFIC_PER_CHANNEL + balanced tiny-ring threads

---
 src/channel.cc               |  8 ++++++++
 src/enqueue/enqueue.cc       |  9 +++++++++
 src/include/channel.h        |  6 +++++-
 src/tuning/tuning_general.cc | 19 +++++++++++++++++++
 4 files changed, 41 insertions(+), 1 deletion(-)

diff --git a/src/channel.cc b/src/channel.cc
index 06ce6f9..c9e9562 100644
--- a/src/channel.cc
+++ b/src/channel.cc
@@ -27,6 +27,14 @@ int ncclFuncTrafficPerByte(ncclFunc_t func, int nRanks) {
   }
 }
 
+size_t ncclMinTrafficPerChannel() {
+  static size_t value = [] {
+    int64_t v = ncclParamMinTrafficPerChannel();
+    return (v >= 16 && v <= (32 << 10) && v % 16 == 0) ? (size_t)v : (size_t)(32 << 10);
+  }();
+  return value;
+}
+
 size_t ncclCollTrafficPerChannel(size_t trafficBytes, int nChannels) {
   return nChannels > 0 ? DIVUP(trafficBytes / nChannels, 16) * 16 : 0;
 }
diff --git a/src/enqueue/enqueue.cc b/src/enqueue/enqueue.cc
index 9565204..d8300f7 100644
--- a/src/enqueue/enqueue.cc
+++ b/src/enqueue/enqueue.cc
@@ -657,6 +657,15 @@ ncclResult_t ncclPrepareTasks(struct ncclComm* comm, bool* algoNeedConnect, bool
 
 static ncclResult_t scheduleCollTasksToPlan(struct ncclComm* comm, struct ncclKernelPlan* plan,
                                             struct ncclKernelPlanBudget* budget) {
+  {
+    extern int64_t ncclParamMinTrafficPerChannel();
+    int64_t minTraffic = ncclParamMinTrafficPerChannel();
+    if (minTraffic < 16 || minTraffic > (32 << 10) || minTraffic % 16 != 0) {
+      WARN("MIN_TRAFFIC_PER_CHANNEL must be a multiple of 16 in [16,32768]");
+      return ncclInvalidUsage;
+    }
+  }
+
   struct ncclKernelPlanner* planner = &comm->planner;
   // Estimate number of tasks that will fit in this plan.
   int nPlanColls = 0;
diff --git a/src/include/channel.h b/src/include/channel.h
index 2922300..9d5c42d 100644
--- a/src/include/channel.h
+++ b/src/include/channel.h
@@ -18,7 +18,11 @@ ncclResult_t initCollnetChannel(struct ncclComm* comm, int channelId, struct ncc
 ncclResult_t freeChannel(struct ncclChannel* channel, int nRanks, int collnetNRanks, int nvlsNRanks,
                          struct ncclComm* comm);
 
-static constexpr size_t ncclMinTrafficPerChannel = 32 << 10;
+// Optional finer channel allocation; the default preserves upstream planning.
+// Defined in tuning_general.cc so NCCL_PARAM can read NCCL_MIN_TRAFFIC_PER_CHANNEL.
+// Function-local static: reads NCCL_MIN_TRAFFIC_PER_CHANNEL on first use,
+// after the environment is in scope, and keeps the 32 KiB upstream default.
+size_t ncclMinTrafficPerChannel();
 
 struct ncclCollChannelLayout {
   size_t countLo;
diff --git a/src/tuning/tuning_general.cc b/src/tuning/tuning_general.cc
index 1d3cc11..3202632 100644
--- a/src/tuning/tuning_general.cc
+++ b/src/tuning/tuning_general.cc
@@ -12,6 +12,10 @@
 #include "channel.h"
 #include "platforms/platforms.h"
 
+
+// Optional finer channel allocation; the default preserves upstream planning.
+NCCL_PARAM(MinTrafficPerChannel, "MIN_TRAFFIC_PER_CHANNEL", 32 << 10);
+
 NCCL_PARAM(Nthreads, "NTHREADS", -2);
 NCCL_PARAM(Ll128Nthreads, "LL128_NTHREADS", -2);
 
@@ -72,6 +76,20 @@ float ncclTuningGetTime(struct ncclTuningInput_t* const inputs, int a, float lat
   return time;
 }
 
+
+int64_t ncclParamSwitchlessBidirectional();
+
+// Preserve the four direction/root lanes of bidirectional switchless rings by
+// shrinking a tiny Ring's blocks before shrinking its channel count. Larger
+// messages and every other mode keep upstream thread selection.
+static inline void balanceSwitchlessThreads(struct ncclTuningInput* input, int* nt) {
+  if (ncclParamSwitchlessBidirectional() != 2 || input->comm->nChannels < 4) return;
+  if (input->op != NCCL_FUNC_ALL_REDUCE && input->func != NCCL_FUNC_ALL_REDUCE) return;
+  int nc = input->comm->nChannels;
+  int threadThreshold = input->comm->tuningContext.threadThresholds[NCCL_ALGO_RING][NCCL_PROTO_SIMPLE];
+  while (*nt > 128 && input->nBytes < (size_t)nc * (size_t)*nt * (size_t)threadThreshold) *nt /= 2;
+}
+
 static int ncclTuningGetNthreads(const char* name, int env, int min, int max, int def) {
   int nt = env;
   if (nt > 0) {
@@ -176,6 +194,7 @@ ncclResult_t ncclTuningGetChannels(struct ncclTuningInput_t* const input, struct
     nc = input->comm->nvlsChannels;
   } else {
     // Ring/Tree/one-RPN PAT channel tuning
+    balanceSwitchlessThreads(input, &nt);
     while (input->nBytes < nc * nt * threadThreshold) {
       if (nc >= 2) nc--;
       else break;
-- 
2.51.2

