diff --git a/src/tl_templates/cuda/math.h b/src/tl_templates/cuda/math.h
index 82fe09bb..bc1878d3 100644
--- a/src/tl_templates/cuda/math.h
+++ b/src/tl_templates/cuda/math.h
@@ -45,3 +45,48 @@ bfloat16_t fast_cos(bfloat16_t x) { return bfloat16_t(fast_cos(float(x))); }
 TL_DEVICE
 bfloat16_t fast_tanh(bfloat16_t x) { return bfloat16_t(fast_tanh(float(x))); }
 } // namespace cutlass
+
+namespace tl {
+
+TL_DEVICE float clamp_symmetric(float x, float limit) {
+  float result;
+  asm("min.NaN.xorsign.abs.f32 %0, %1, %2;"
+      : "=f"(result)
+      : "f"(x), "f"(limit));
+  return result;
+}
+
+TL_DEVICE half_t clamp_symmetric(half_t x, half_t limit) {
+  uint16_t result;
+  asm("min.NaN.xorsign.abs.f16 %0, %1, %2;"
+      : "=h"(result)
+      : "h"(x.raw()), "h"(limit.raw()));
+  return half_t::bitcast(result);
+}
+
+TL_DEVICE bfloat16_t clamp_symmetric(bfloat16_t x, bfloat16_t limit) {
+  uint16_t result;
+  asm("min.NaN.xorsign.abs.bf16 %0, %1, %2;"
+      : "=h"(result)
+      : "h"(x.raw()), "h"(limit.raw()));
+  return bfloat16_t::bitcast(result);
+}
+
+TL_DEVICE __half2 clamp_symmetric2(__half2 x, __half2 limit) {
+  uint1 result;
+  asm("min.NaN.xorsign.abs.f16x2 %0, %1, %2;"
+      : "=r"(result.x)
+      : "r"(to_uint1(x).x), "r"(to_uint1(limit).x));
+  return from_uint1<__half2>(result);
+}
+
+TL_DEVICE __nv_bfloat162 clamp_symmetric2(__nv_bfloat162 x,
+                                          __nv_bfloat162 limit) {
+  uint1 result;
+  asm("min.NaN.xorsign.abs.bf16x2 %0, %1, %2;"
+      : "=r"(result.x)
+      : "r"(to_uint1(x).x), "r"(to_uint1(limit).x));
+  return from_uint1<__nv_bfloat162>(result);
+}
+
+} // namespace tl
diff --git a/testing/python/language/test_tilelang_language_clamp.py b/testing/python/language/test_tilelang_language_clamp.py
index 0abe9d12..7ac0c070 100644
--- a/testing/python/language/test_tilelang_language_clamp.py
+++ b/testing/python/language/test_tilelang_language_clamp.py
@@ -115,6 +115,47 @@ def test_clamp():
     run_clamp_value_range(1024, 128, T.float32)
 
 
+@tilelang.testing.requires_cuda
+@pytest.mark.parametrize("threads", [32, 64, 128])
+@pytest.mark.parametrize("dtype", ["float16", "bfloat16", "float32"])
+def test_clamp_symmetric(threads, dtype):
+    import torch
+
+    if torch.cuda.get_device_capability() < (8, 6):
+        pytest.skip("clamp_symmetric requires SM86+")
+
+    @T.prim_func
+    def main(A: T.Tensor((128,), dtype), B: T.Tensor((128,), dtype), C: T.Tensor((128,), dtype)):
+        with T.Kernel(1, threads=threads):
+            for i in T.Parallel(128):
+                C[i] = T.clamp_symmetric(A[i], B[i])
+
+    kernel = tilelang.compile(main)
+    torch_dtype = getattr(torch, dtype)
+    subnormal = torch.finfo(torch_dtype).tiny / 2
+    values = [0.0, -0.0, 0.5, -0.5, 4.0, -4.0, float("inf"), -float("inf"), float("nan"), -float("nan"), subnormal, -subnormal]
+    a = torch.tensor(values, device="cuda", dtype=torch_dtype).repeat(11)[:128].contiguous()
+    int_dtype = torch.int32 if dtype == "float32" else torch.int16
+    sign_mask = torch.iinfo(int_dtype).min
+    # Construct negative NaNs by bits: narrowing may canonicalize their sign.
+    a.view(int_dtype)[9::12].bitwise_or_(sign_mask)
+    c = torch.empty_like(a)
+    for limit in [2.0, subnormal, float("inf")]:
+        b = torch.full_like(a, limit)
+        # Input-only, limit-only, and both-NaN lanes, mixed with numeric lanes
+        # in the same packed x2 call. Include both NaN signs in each operand.
+        b[2::12] = float("nan")
+        b[5::12] = float("nan")
+        b.view(int_dtype)[5::12].bitwise_or_(sign_mask)
+        b[8::24] = float("nan")
+        b[9::24] = float("nan")
+        kernel(a, b, c)
+        ref = torch.clamp(a.float(), -b.float(), b.float())
+        torch.testing.assert_close(c.float(), ref, equal_nan=True, atol=0, rtol=0)
+        numeric = ~torch.isnan(ref)
+        assert torch.equal(torch.signbit(c[numeric]), torch.signbit(ref[numeric]))
+
+
 FP8_OPS = {
     "max": lambda a, b, dtype: T.max(a, b),
     "min": lambda a, b, dtype: T.min(a, b),
