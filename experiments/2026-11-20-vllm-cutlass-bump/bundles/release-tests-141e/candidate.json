{
  "description": "Release tests (v66-141e): the manifest's vLLM test files in the image, chunked with timeouts; per-test outcomes under /c/release-tests.",
  "image": "spark-ds41f:1107-vllm-6d66-cutlass-4.8.1",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "PYTHONPATH": "/b",
    "TILELANG_CACHE_DIR": "/c/tilelang-release-tests",
    "ENGRAM_ROWS_TEST_DIR": "/c/engram-rows-test",
    "DIRECT_IO_TEST_DIR": "/c/direct-io-test",
    "DS41F_SNAPSHOT": "/models"
  },
  "workdir": "vllm",
  "io_uring": true,
  "argv": [
    "/b/release_test_runner.py",
    "/b/manifest.json",
    "/c/release-tests/v66-141e"
  ],
  "verdict": "exit",
  "mounts": [
    [
      "manifest.json",
      "/b/manifest.json"
    ],
    [
      "release_test_runner.py",
      "/b/release_test_runner.py"
    ],
    [
      "tblib_stub.py",
      "/b/tblib_stub.py"
    ],
    [
      "offline_skip.py",
      "/b/offline_skip.py"
    ],
    [
      "deepseek_models.py",
      "/b/deepseek_models.py"
    ],
    [
      "~/nvmodels/DeepSeek-V4.1-Flash-1017",
      "/models"
    ]
  ]
}
